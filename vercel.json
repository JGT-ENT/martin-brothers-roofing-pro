{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist/client",
  "framework": null,
  "regions": ["iad1"],
  "rewrites": [
    { "source": "/((?!assets/|favicon\\.ico|robots\\.txt).*)", "destination": "/api/[...all]" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "functions": {
    "api/[...all].ts": {
      "maxDuration": 15
    }
  }
}
